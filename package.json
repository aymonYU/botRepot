{
  "name": "youtube-bot-report",
  "version": "1.0.0",
  "description": "YouTube视频监控和AI分析报告系统",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "check": "bun run src/scheduler.ts"
  },
  "keywords": [
    "youtube",
    "ai",
    "gemini",
    "hono",
    "bot",
    "report"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7",
    "googleapis": "^144.0.0",
    "openai": "^4.73.0",
    "cron": "^3.1.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "latest"
  }
}

